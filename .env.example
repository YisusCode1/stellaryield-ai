# Stellar Network Configuration
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org:443
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# XOXNO integration always selects the published `stellarTestnet` deployment
# from @xoxno/sdk-js. Do not configure a custom Vault or a hard-coded token
# contract for the XOXNO Supply/Withdraw flow.
VITE_STELLAR_NETWORK=testnet
VITE_STELLAR_RPC_URL=https://stellar-testnet-gateway.xoxno.com

# API: datos reales de XOXNO; la aplicación no dispone de modo simulado.
VITE_API_URL=http://localhost:3000
